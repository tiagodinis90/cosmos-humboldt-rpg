  "graphs": [
    {
      "id": "synthetic.lab.graph",
      "start": "open",
      "status": "draft",
      "provenance": {
        "classification": "synthetic",
        "status": "draft",
        "note": "Original compatibility fixture; not proposed story content."
      },
      "cards": [
        {
          "type": "line",
          "id": "open",
          "textKey": "line.open",
          "speakerId": "researcher",
          "next": "passive"
        },
        {
          "type": "passive",
          "id": "passive",
          "probes": [
            {
              "id": "pattern.insight",
              "skill": "logic",
              "atLeast": 1,
              "textKey": "insight.pattern"
            }
          ],
          "next": "choice"
        },
        {
          "type": "choice",
          "id": "choice",
          "choices": [
            {
              "id": "red.try",
              "labelKey": "choice.red",
              "next": "red.success",
              "check": {
                "id": "lab.red.control",
                "kind": "red",
                "skill": "logic",
                "difficulty": 13,
                "success": "red.success",
                "failure": "red.failure"
              }
            },
            {
              "id": "white.try",
              "labelKey": "choice.white",
              "next": "white.success",
              "check": {
                "id": "lab.white.reading",
                "kind": "white",
                "skill": "logic",
                "difficulty": 13,
                "success": "white.success",
                "failure": "white.failure"
              }
            },
            {
              "id": "evidence.try",
              "labelKey": "choice.evidence",
              "next": "evidence.line",
              "when": {
                "op": "flag",
                "name": "evidence.note"
              }
            },
            {
              "id": "record",
              "labelKey": "choice.record",
              "next": "record.set"
            },
            {
              "id": "leave",
              "labelKey": "choice.leave",
              "next": "done"
            }
          ]
        },
        {
          "type": "line",
          "id": "red.failure",
          "textKey": "line.red.failure",
          "next": "choice"
        },
        {
          "type": "line",
          "id": "red.success",
          "textKey": "line.done",
          "next": "done"
        },
        {
          "type": "line",
          "id": "white.failure",
          "textKey": "line.white.failure",
          "next": "choice"
        },
        {
          "type": "line",
          "id": "white.success",
          "textKey": "line.white.success",
          "next": "choice"
        },
        {
          "type": "line",
          "id": "evidence.line",
          "textKey": "line.evidence.check",
          "next": "evidence.choice"
        },
        {
          "type": "choice",
          "id": "evidence.choice",
          "choices": [
            {
              "id": "evidence.roll",
              "labelKey": "choice.resume",
              "next": "boost.success",
              "check": {
                "id": "lab.evidence.boost",
                "kind": "white",
                "skill": "logic",
                "difficulty": 13,
                "success": "boost.success",
                "failure": "boost.failure"
              }
            }
          ]
        },
        {
          "type": "line",
          "id": "boost.failure",
          "textKey": "line.white.failure",
          "next": "done"
        },
        {
          "type": "line",
          "id": "boost.success",
          "textKey": "line.white.success",
          "next": "done"
        },
        {
          "type": "line",
          "id": "record.set",
          "textKey": "line.flagged",
          "next": "conditional",
          "sets": [
            "sample.recorded"
          ]
        },
        {
          "type": "fork",
          "id": "conditional",
          "routes": [
            {
              "when": {
                "op": "flag",
                "name": "sample.recorded"
              },
              "next": "recorded"
            }
          ],
          "otherwise": "unrecorded"
        },
        {
          "type": "line",
          "id": "recorded",
          "textKey": "line.flagged",
          "next": "done"
        },
        {
          "type": "line",
          "id": "unrecorded",
          "textKey": "line.no_flag",
          "next": "done"
        },
        {
          "type": "end",
          "id": "done",
          "textKey": "line.done"
        }
      ]
    }
  ],
  "encounters": [
    {
      "id": "synthetic.lab.encounter",
      "graphId": "synthetic.lab.graph",
      "status": "draft",
      "outcomes": [
        {
          "when": {
            "op": "flag",
            "name": "lab.complete"
          },
          "effects": [
            {
              "type": "evidence.add",
              "evidence": {
                "id": "evidence.note",
                "kind": "observation",
                "dateKey": "evidence.sample.date",
                "contentKey": "evidence.sample.content",
                "sourceKey": "evidence.sample.source",
                "provenance": {
                  "classification": "synthetic",
                  "status": "draft",
                  "note": "Synthetic test evidence."
                },
                "modifies": [
                  {
                    "checkId": "lab.evidence.boost",
                    "amount": 2
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
