; COSMOS: Humboldt — Godot foundation. Open this folder in Godot 4.7.x (Standard).

config_version=5

[application]

config/name="COSMOS: Humboldt"
config/description="Narrative RPG foundation. All art and dialogue are provisional."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Session="*res://src/game/session.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme/cosmos_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.105, 0.149, 0.133, 1)
